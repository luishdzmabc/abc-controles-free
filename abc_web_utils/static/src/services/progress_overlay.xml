<templates xml:space="preserve">

    <t t-name="abc_web_utils.ProgressOverlay">
        <div class="o_abc_progress_overlay d-flex align-items-center justify-content-center"
             role="alertdialog" aria-modal="true" aria-live="polite">
            <div class="o_abc_progress_card card shadow-lg">
                <div class="card-body">
                    <h5 class="card-title mb-3" t-if="props.state.message"
                        t-out="props.state.message"/>
                    <div class="progress mb-2" style="height: 1.25rem;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated"
                             role="progressbar"
                             t-att-aria-valuenow="percent"
                             aria-valuemin="0" aria-valuemax="100"
                             t-attf-style="width: {{ percent }}%;">
                            <t t-out="percent"/>%
                        </div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>
                            <t t-out="props.state.done"/> / <t t-out="props.state.total"/>
                        </span>
                        <span>
                            Elapsed: <t t-out="elapsedText"/>
                        </span>
                        <span t-if="remainingText">
                            Time left: <t t-out="remainingText"/>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
