<odoo>

    <!-- Unified list: pending activities across ALL models at once. -->
    <record id="view_abc_activity_board_list" model="ir.ui.view">
        <field name="name">abc.activity.board.list</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <list string="Mis actividades (ABC)"
                  default_order="date_deadline asc, id asc"
                  create="false" sample="1">
                <field name="active" column_invisible="1"/>
                <field name="summary" string="Resumen"/>
                <field name="activity_type_id" string="Tipo"/>
                <field name="res_model_id" string="Modelo"/>
                <field name="res_name" string="Documento"/>
                <field name="user_id" widget="many2one_avatar_user" string="Asignado a"/>
                <field name="date_deadline" widget="remaining_days" string="Vencimiento"/>
                <field name="state" string="Estado"/>
                <button name="action_done" type="object" string="Hecho"
                        icon="fa-check" invisible="not active"/>
                <button name="action_open_document" type="object" string="Abrir documento"
                        icon="fa-external-link"
                        invisible="not res_model or res_id == 0"/>
            </list>
        </field>
    </record>

    <!-- Kanban grouped by deadline state, mobile-friendly. -->
    <record id="view_abc_activity_board_kanban" model="ir.ui.view">
        <field name="name">abc.activity.board.kanban</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="res_model_id"
                    create="false" sample="1">
                <field name="active"/>
                <field name="icon"/>
                <field name="activity_decoration"/>
                <templates>
                    <t t-name="card">
                        <div class="fw-bold">
                            <i t-if="record.icon.value"
                               t-attf-class="fa #{record.icon.value} fa-fw me-1"
                               role="img" aria-label="Tipo" title="Tipo"/>
                            <field name="summary"/>
                        </div>
                        <div t-if="record.res_name.value" class="text-muted">
                            <field name="res_name"/>
                        </div>
                        <div>
                            <field name="activity_type_id"/>
                        </div>
                        <footer>
                            <field name="date_deadline" widget="remaining_days"/>
                            <field class="ms-auto" name="user_id"
                                   widget="many2one_avatar_user"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar over the deadline. -->
    <record id="view_abc_activity_board_calendar" model="ir.ui.view">
        <field name="name">abc.activity.board.calendar</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <calendar string="Mis actividades (ABC)"
                      date_start="date_deadline"
                      color="activity_type_id"
                      mode="month"
                      create="false">
                <field name="summary"/>
                <field name="res_name"/>
                <field name="activity_type_id" filters="1"/>
            </calendar>
        </field>
    </record>

    <!-- Search: group by model / type / deadline + deadline-state filters. -->
    <record id="view_abc_activity_board_search" model="ir.ui.view">
        <field name="name">abc.activity.board.search</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <search string="Mis actividades (ABC)">
                <field name="summary" string="Resumen"
                       filter_domain="['|', ('summary', 'ilike', self), ('res_name', 'ilike', self)]"/>
                <field name="activity_type_id"/>
                <field name="res_name" string="Documento"/>
                <separator/>
                <filter string="Vencidas" name="filter_overdue"
                        domain="[('date_deadline', '&lt;', 'today')]"/>
                <filter string="Hoy" name="filter_today"
                        domain="[('date_deadline', '=', 'today')]"/>
                <filter string="Planeadas" name="filter_planned"
                        domain="[('date_deadline', '&gt;', 'today')]"/>
                <separator/>
                <group name="group_by">
                    <filter string="Modelo" name="group_by_res_model"
                            context="{'group_by': 'res_model_id'}"/>
                    <filter string="Tipo de actividad" name="group_by_type"
                            context="{'group_by': 'activity_type_id'}"/>
                    <filter string="Vencimiento" name="group_by_deadline"
                            context="{'group_by': 'date_deadline'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: only the current user's pending activities, unified. -->
    <record id="action_abc_activity_board" model="ir.actions.act_window">
        <field name="name">Mis actividades (ABC)</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="view_abc_activity_board_search"/>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'force_search_count': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tienes actividades pendientes
            </p>
            <p>
                Aquí ves, en un solo tablero, todas tus actividades pendientes
                de cualquier modelo de Odoo. Agrúpalas por modelo, tipo o fecha
                y márcalas como hechas con un clic.
            </p>
        </field>
    </record>

    <!-- Bind our custom list/kanban/calendar to the action. -->
    <record id="action_abc_activity_board_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_abc_activity_board_list"/>
        <field name="act_window_id" ref="action_abc_activity_board"/>
    </record>
    <record id="action_abc_activity_board_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_abc_activity_board_kanban"/>
        <field name="act_window_id" ref="action_abc_activity_board"/>
    </record>
    <record id="action_abc_activity_board_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_abc_activity_board_calendar"/>
        <field name="act_window_id" ref="action_abc_activity_board"/>
    </record>

    <!-- Top-level menu opening the unified board directly. -->
    <menuitem id="menu_abc_activity_board_root"
              name="Mis actividades (ABC)"
              action="action_abc_activity_board"
              groups="base.group_user"
              sequence="90"/>

</odoo>
